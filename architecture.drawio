        <mxCell id="e-user-buyer" value="intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;fontSize=10;fontColor=#475569;endArrow=block;endFill=1;" edge="1" parent="1" source="end-user" target="buyer-agent">
          <mxGeometry relative="1" as="geometry">
